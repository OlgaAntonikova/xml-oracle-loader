<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<!-- IP-address server Oracle -->
		<add key="DbHost" value="your-db-host" />

		<!-- строки подключения -->
		<add key="DbPort" value="1521"/>
		<add key="DbServiceName" value="XEPDB2"/>
		<add key="DbUserId" value="your-db-user"/>
		<add key="DbPwd" value="your-db-password"/>
	</appSettings>
</configuration>