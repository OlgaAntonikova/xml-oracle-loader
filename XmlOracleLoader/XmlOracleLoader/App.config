<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!--
		Oracle connection settings. Environment variables take precedence:
		XOL_DB_HOST, XOL_DB_PORT, XOL_DB_SERVICE, XOL_DB_USER, XOL_DB_PASSWORD.
		Keep credentials in environment variables, not in this file.
	-->
	<appSettings>
		<add key="DbHost" value="localhost" />
		<add key="DbPort" value="1521" />
		<add key="DbServiceName" value="FREEPDB1" />
		<add key="DbUserId" value="" />
		<add key="DbPwd" value="" />
	</appSettings>
</configuration>
