<Window x:Class="XmlOracleLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XmlOracleLoader.ViewModels;assembly=XmlOracleLoader.ViewModels"
        Title="XML Oracle Loader" Height="680" Width="1180" MinHeight="420" MinWidth="760"
        Background="#F5F6F8" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="Border" Color="#D9DDE3"/>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="170" MinHeight="80"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}"
                    Content="Open XML…" Command="{Binding OpenFileCommand}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}"
                    Content="Import to Oracle" Command="{Binding ImportCommand}"/>
            <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}"
                    Content="Export from Oracle…" Command="{Binding ExportCommand}"/>
            <TextBlock Text="{Binding FileName}" ToolTip="{Binding FilePath}" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Summary -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/>
        </Border>

        <!-- Preview grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F3"
                  Background="White" BorderBrush="{StaticResource Border}" RowHeaderWidth="0"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding Errors}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsValid}" Value="True">
                            <Setter Property="ToolTip" Value="{x:Null}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                            <Setter Property="Background" Value="#FDECEC"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="40"/>
                <DataGridTextColumn Header="Order" Binding="{Binding Line.OrderNumber}" Width="115"/>
                <DataGridTextColumn Header="Shipment" Binding="{Binding Line.ShipmentDate}" Width="90"/>
                <DataGridTextColumn Header="Product" Binding="{Binding Line.ProductCode}" Width="90"/>
                <DataGridTextColumn Header="Product name" Binding="{Binding Line.ProductName}" Width="1.3*" MinWidth="160"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Line.Quantity}" Width="60"/>
                <DataGridTextColumn Header="Material" Binding="{Binding Line.MaterialCode}" Width="90"/>
                <DataGridTextColumn Header="Material name" Binding="{Binding Line.MaterialName}" Width="*" MinWidth="120"/>
                <DataGridTextColumn Header="Per product" Binding="{Binding Line.QuantityPerProduct}" Width="80"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Line.UnitOfMeasure}" Width="50"/>
                <DataGridTextColumn Header="Problems" Binding="{Binding Errors}" Width="*" MinWidth="120" Foreground="#B91C1C"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Log -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Log" FontWeight="SemiBold" Margin="12,8,12,4"/>
                <ListBox ItemsSource="{Binding Log}" BorderThickness="0" Margin="4,0,4,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LogEntry}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding TimeText}" Foreground="#9CA3AF" Width="64" FontFamily="Consolas"/>
                                <TextBlock x:Name="Level" Text="{Binding Level}" Width="70" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                    <Setter TargetName="Level" Property="Foreground" Value="#15803D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter TargetName="Level" Property="Foreground" Value="#B45309"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter TargetName="Level" Property="Foreground" Value="#B91C1C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
